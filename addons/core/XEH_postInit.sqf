#include "script_component.hpp"

if (!hasInterface) exitWith {};


// Remove ACE's option for repacking magazines from the inventory context menu.
// The option ID is generated by CBA at registration, so it is looked up by display name. Thank you ACE for making this harder.
[{
    private _options = (missionNamespace getVariable ["cba_ui_ItemContextMenuOptions", createHashMap]) getOrDefault ["#Magazine", createHashMap];
    private _id = "";

    {
        // _y = [slots, displayName, ...]
        if ((_y select 1) == "STR_ace_magazinerepack_RepackMagazines") exitWith {
            _id = _x;
        };
    } forEach _options;

    if (_id == "") exitWith {
        WARNING("ACE inventory repack option not found, cannot remove it");
    };

    if !(["#Magazine", _id] call CBA_fnc_removeItemContextMenuOption) then {
        WARNING_1("Failed to remove ACE inventory repack option (id %1)",_id);
    };
}] call CBA_fnc_execNextFrame;



private _repackAction = [
    QGVAR(repackMagazines),
    localize LSTRING(repackMagazines),
    QPATHTOF(data\cvo_icon_repack_ca.paa),
    {},
    {true}
] call ace_interact_menu_fnc_createAction;

["CAManBase", 1, ["ACE_SelfActions"], _repackAction, true] call ace_interact_menu_fnc_addActionToClass;


// Submenus: the children are built on demand by getRepackActions, the params select the mode
private _refillAction = [
    QGVAR(refill),
    localize LSTRING(refill),
    QPATHTOF(data\cvo_icon_refill_ca.paa),
    {},
    {true},
    FUNC(getRepackActions),
    [false]
] call ace_interact_menu_fnc_createAction;

private _unloadAction = [
    QGVAR(unload),
    localize LSTRING(unload),
    QPATHTOF(data\cvo_icon_unload_ca.paa),
    {},
    {true},
    FUNC(getRepackActions),
    [true]
] call ace_interact_menu_fnc_createAction;

["CAManBase", 1, ["ACE_SelfActions", QGVAR(repackMagazines)], _refillAction, true] call ace_interact_menu_fnc_addActionToClass;
["CAManBase", 1, ["ACE_SelfActions", QGVAR(repackMagazines)], _unloadAction, true] call ace_interact_menu_fnc_addActionToClass;


// Add event handlers and handle player unit being changed mid game (by respawning or using selectPlayer command)
PVAR(ReloadedEHID) = -1;
PVAR(onMagazineUnloadedEHID) = -1;
PVAR(player) = objNull;

[
    {!isNull player},
    {
        ["unit", {
            if (!isNull PVAR(player)) then {
                if (PVAR(ReloadedEHID) != -1) then {
                    PVAR(player) removeEventHandler ["Reloaded", PVAR(ReloadedEHID)];
                };
                if (PVAR(onMagazineUnloadedEHID) != -1) then {
                    PVAR(player) removeEventHandler ["MagazineUnloaded", PVAR(onMagazineUnloadedEHID)];
                };
            };

            PVAR(player) = player;
            PVAR(ReloadedEHID) = player addEventHandler ["Reloaded", FUNC(onReloaded)];
            PVAR(onMagazineUnloadedEHID) = player addEventHandler ["MagazineUnloaded", FUNC(onMagazineUnloaded)];
        }, true] call CBA_fnc_addPlayerEventHandler;
    }
] call CBA_fnc_waitUntilAndExecute;
